<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\common.props" />
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <AssemblyTitle>BenchmarkDotNet.TestingPlatform</AssemblyTitle>
    <AssemblyName>BenchmarkDotNet.TestingPlatform</AssemblyName>
    <PackageId>BenchmarkDotNet.TestingPlatform</PackageId>
    <Description>Runs BenchmarkDotNet benchmarks as tests through Microsoft.Testing.Platform</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ProduceReferenceAssembly>True</ProduceReferenceAssembly>
    <RootNamespace>BenchmarkDotNet.TestingPlatform</RootNamespace>

    <!--
      Referencing Microsoft.Testing.Platform.MSBuild defaults IsTestingPlatformApplication to true, which would make
      the SDK treat this library as a test application: it would stop being packable and would get a generated entry
      point compiled into it. This project implements the adapter, it is not a test application itself.
    -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Testing.Platform.MSBuild brings in Microsoft.Testing.Platform, generates the entry point of the
         benchmark app and provides the `dotnet test` integration. It must flow to the consuming project, so it is
         deliberately not marked as PrivateAssets. -->
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" Version="2.3.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BenchmarkDotNet\BenchmarkDotNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the VSTest adapter: enumerating benchmarks is protocol agnostic. -->
    <Compile Include="..\BenchmarkDotNet.TestAdapter\BenchmarkEnumerator.cs" Link="Shared\BenchmarkEnumerator.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- A trailing separator in PackagePath is not portable: on Linux it packs the file as `buildTransitive//...`,
         which trips NU5129. Listing both folders on a single item keeps the paths correct on every platform. -->
    <None Include="build\BenchmarkDotNet.TestingPlatform.props" Pack="true" PackagePath="build;buildTransitive" />
  </ItemGroup>
  <Import Project="..\..\build\common.targets" />
</Project>

