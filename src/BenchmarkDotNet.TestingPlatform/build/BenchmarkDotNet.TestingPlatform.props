<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!--
      Referencing this package turns the benchmark project into a Microsoft.Testing.Platform application, which means
      Microsoft.Testing.Platform.MSBuild generates the entry point and hooks up `dotnet test`. Set this to false if the
      project already owns its entry point (for example, one that calls BenchmarkSwitcher).
    -->
    <IsTestingPlatformApplication Condition="'$(IsTestingPlatformApplication)' == ''">true</IsTestingPlatformApplication>

    <!-- Required for `dotnet test` to route to Microsoft.Testing.Platform on SDKs older than .NET 10. -->
    <TestingPlatformDotnetTestSupport Condition="'$(TestingPlatformDotnetTestSupport)' == ''">true</TestingPlatformDotnetTestSupport>

    <!--
      Benchmarks measure the machine they run on, so running the target frameworks of a multi-targeted project
      concurrently would distort the results. Disable it unless it is explicitly asked for.
    -->
    <TestTfmsInParallel Condition="'$(TestTfmsInParallel)' == ''">false</TestTfmsInParallel>
  </PropertyGroup>

  <!--
    Registers BenchmarkDotNet with the entry point that Microsoft.Testing.Platform.MSBuild generates, so that no
    manual `builder.AddBenchmarkDotNet()` call is needed. See the "Expected extensions items shape" comment in
    Microsoft.Testing.Platform.MSBuild.targets.
  -->
  <ItemGroup>
    <TestingPlatformBuilderHook Include="2C7B4E93-51F8-4E0B-9A8E-6D0D4B4C1F27">
      <DisplayName>BenchmarkDotNet</DisplayName>
      <TypeFullName>BenchmarkDotNet.TestingPlatform.TestingPlatformBuilderHook</TypeFullName>
    </TestingPlatformBuilderHook>
  </ItemGroup>
</Project>
