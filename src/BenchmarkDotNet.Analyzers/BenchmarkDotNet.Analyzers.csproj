<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\common.props" />
  <PropertyGroup>
    <!-- Avoid ID conflicts with the package project. -->
    <PackageId>BenchmarkDotNet.Analyzers</PackageId>
  </PropertyGroup>
  <Import Project="..\..\build\roslynBands.props" />
  <PropertyGroup>
    <!-- Formatting in AnalyzerReleases.Unshipped.md -->
    <NoWarn>$(NoWarn);RS2007</NoWarn>
    <!-- A HashSet built with SymbolEqualityComparer.Default is what RS1024 asks for, but the rule as shipped in
         Microsoft.CodeAnalysis.Analyzers 3.3.2 (bundled with 4.0.0) reports it anyway. -->
    <NoWarn Condition="'$(MccVersion)' == '4.0'">$(NoWarn);RS1024</NoWarn>
  </PropertyGroup>
  <ItemGroup>
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(MccPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="BenchmarkDotNetAnalyzerResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>BenchmarkDotNetAnalyzerResources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="BenchmarkDotNetAnalyzerResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>BenchmarkDotNetAnalyzerResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>BenchmarkDotNet.Analyzers.Tests,</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <Import Project="..\..\build\common.targets" />
</Project>