<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\common.props" />
  <PropertyGroup>
    <!-- Avoid ID conflicts with the package project. -->
    <PackageId>BenchmarkDotNet.Analyzers</PackageId>
  </PropertyGroup>
  <Import Project="..\..\build\roslynBands.props" />
  <PropertyGroup>
    <!-- Formatting in AnalyzerReleases.Unshipped.md -->
    <NoWarn>$(NoWarn);RS2007</NoWarn>
    <!-- Suppress false positives due to a bug in v3.8.0. -->
    <NoWarn Condition="'$(MccVersion)' == '3.8'">$(NoWarn);RS2002</NoWarn>
  </PropertyGroup>
  <ItemGroup>
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(MccPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
  <ItemGroup>
    <!-- RunnableConstants (the code generator's member names + ReservedInstanceMemberNames, the subset that can
         collide with a [Params*] member), shared with the runtime ParamsValidator so the checks can't drift. -->
    <Compile Include="..\BenchmarkDotNet\Code\RunnableConstants.cs" Link="Shared\RunnableConstants.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="BenchmarkDotNetAnalyzerResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>BenchmarkDotNetAnalyzerResources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="BenchmarkDotNetAnalyzerResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>BenchmarkDotNetAnalyzerResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>BenchmarkDotNet.Analyzers.Tests,</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <Import Project="..\..\build\common.targets" />
</Project>