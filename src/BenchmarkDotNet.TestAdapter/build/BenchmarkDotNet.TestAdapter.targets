<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    The choice of test platform is made here rather than in the .props, because a package's .props is imported before
    the project file is read: a BenchmarkDotNetUseVSTest or GenerateProgramFile set in the project would not be visible
    yet. Microsoft.Testing.Platform.MSBuild resolves IsTestingPlatformApplication late for the same reason.
  -->
  <PropertyGroup>
    <!--
      Microsoft.Testing.Platform is the default. Two things opt out of it:

        * BenchmarkDotNetUseVSTest, for the tooling that has no Microsoft.Testing.Platform support (Visual Studio 2019)
          and for solutions that mix benchmark projects with VSTest based test projects.
        * GenerateProgramFile, which is how a project says it already has an entry point of its own, typically one
          that calls BenchmarkSwitcher. Generating a second one would not compile.
    -->
    <!--
      The opt-out has to overwrite the property rather than fill in a blank one. IsTestingPlatformApplication may
      already have been set to true by the project itself or by another package imported before this file, and a
      condition on it being empty would then never fire, silently ignoring the opt-out. This is the same shape
      MSTest.TestAdapter.targets uses to turn the platform off when EnableMSTestRunner is not set.
    -->
    <IsTestingPlatformApplication Condition="'$(BenchmarkDotNetUseVSTest)' == 'true' or '$(GenerateProgramFile)' == 'false'">false</IsTestingPlatformApplication>
    <IsTestingPlatformApplication Condition="'$(IsTestingPlatformApplication)' == ''">true</IsTestingPlatformApplication>

    <!-- Required for `dotnet test` to route to Microsoft.Testing.Platform on SDKs older than .NET 10. -->
    <TestingPlatformDotnetTestSupport Condition="'$(TestingPlatformDotnetTestSupport)' == '' and '$(IsTestingPlatformApplication)' == 'true'">true</TestingPlatformDotnetTestSupport>

    <!--
      A project that also references Microsoft.NET.Test.Sdk gets a generated stub Main from it, and the compiler
      prefers that synchronous entry point over the async one Microsoft.Testing.Platform.MSBuild generates (CS8892,
      an error under TreatWarningsAsErrors). The application then starts and exits without running anything. The
      target which generates the stub is gated on this property, so clearing it leaves the platform entry point.
      This is read above before it is written, so it still works as the "I have my own entry point" opt-out.
    -->
    <GenerateProgramFile Condition="'$(IsTestingPlatformApplication)' == 'true'">false</GenerateProgramFile>
  </PropertyGroup>

  <!--
    Registers BenchmarkDotNet with the entry point that Microsoft.Testing.Platform.MSBuild generates, so that no
    manual `builder.AddBenchmarkDotNet()` call is needed. See the "Expected extensions items shape" comment in
    Microsoft.Testing.Platform.MSBuild.targets.
  -->
  <ItemGroup Condition="'$(IsTestingPlatformApplication)' == 'true'">
    <TestingPlatformBuilderHook Include="2C7B4E93-51F8-4E0B-9A8E-6D0D4B4C1F27">
      <DisplayName>BenchmarkDotNet</DisplayName>
      <TypeFullName>BenchmarkDotNet.TestAdapter.TestingPlatform.TestingPlatformBuilderHook</TypeFullName>
    </TestingPlatformBuilderHook>
  </ItemGroup>
</Project>
