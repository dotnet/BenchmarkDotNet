<!--
Projects that reference the BenchmarkDotNet projects weave with this project's build output, so changes to it apply on the
next build. The package it packs carries only buildTransitive\netstandard2.0\BenchmarkDotNet.Weaver.targets: if that file
changes, increment the WeaverPackageVersion in the common.props file, then run `build.cmd pack-weaver`.
-->

<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\common.props" />
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <!-- Only the package is versioned independently: the assembly, which the full pack also bundles into
         BenchmarkDotNet.Annotations, keeps the BenchmarkDotNet version. -->
    <PackageVersion>$(WeaverPackageVersion)</PackageVersion>
    <!-- Not per configuration: weaving finds the task here whatever configuration built it, which is not always the
         configuration of the project being woven (a solution that does not contain this project builds it in its default
         configuration). -->
    <OutputPath>$(MSBuildThisFileDirectory)bin\</OutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5100;NU5127;NU5128</NoWarn>
    <!-- AsmResolver is not signed. -->
    <SignAssembly>false</SignAssembly>
    <DelaySign>false</DelaySign>
    <!-- Fix error NU5017: Cannot create a package that has no dependencies nor content. -->
    <IsPackable Condition="'$(IsFullPack)' == 'true'">false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AsmResolver.DotNet" Version="6.1.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.12.2" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.12.2" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The package only locates the source tree; the rest of the targets and the task are used from there. -->
    <Content Include="$(MSBuildThisFileDirectory)buildTransitive\netstandard2.0\BenchmarkDotNet.Weaver.targets" Pack="true" PackagePath="buildTransitive/netstandard2.0" />
    <None Remove="packages\**" />
  </ItemGroup>

  <!-- Settings for PolySharp -->
  <PropertyGroup>
    <PolySharpIncludeGeneratedTypes>
      System.Runtime.CompilerServices.CompilerFeatureRequiredAttribute,
      System.Runtime.CompilerServices.RequiredMemberAttribute
    </PolySharpIncludeGeneratedTypes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.17.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Import Project="..\..\build\common.targets" />
</Project>